<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Draws each of the plugin's windows to pictures without the game, so a layout is looked
    at before anyone loads it. The window code is the plugin's own, compiled in, and talks to
    a stand-in site that answers with the tests' fixtures; ImGui and the style are Dalamud's,
    from this machine's XIVLauncher install (or DALAMUD_HOME), found when the program runs.
    `dotnet run` writes the pictures to plugin/previews (git-ignored), or to the folder named
    first, at the font scale named second. It is a workbench and ships nowhere.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>TarotGen.Plugin.Preview</RootNamespace>
    <!-- The plugin's own version, which the Settings tab shows. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../TarotGen.Plugin/TarotGen.Plugin.csproj')), '(?&lt;=&lt;Version&gt;)[^&lt;]+'))</Version>
    <!-- Lets a Linux CI runner compile this Windows-only project. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <DalamudDir Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudDir>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudDir>
    <!-- As the plugin: any warning fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything of the plugin's but what only Dalamud can start (Plugin.cs) and what
         reaches the game or the disk (Services/: the DPAPI token store, the card cache). -->
    <Compile Include="..\TarotGen.Plugin\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\TarotGen.Plugin\Windows\**\*.cs" LinkBase="Windows" />
    <Compile Include="..\TarotGen.Plugin\Configuration.cs" />
    <!-- The tests' fixtures are the site the windows are drawn talking to. -->
    <Content Include="..\TarotGen.Plugin.Tests\Fixtures\**" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="Pictures" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../previews'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Drawing, to paint the card faces and write the pictures. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <!-- Compiled against, never copied: they are loaded from Dalamud's own folder. -->
    <Reference Include="Dalamud" HintPath="$(DalamudDir)Dalamud.dll" Private="false" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudDir)Dalamud.Bindings.ImGui.dll" Private="false" />
    <Reference Include="Dalamud.Bindings.ImPlot" HintPath="$(DalamudDir)Dalamud.Bindings.ImPlot.dll" Private="false" />
  </ItemGroup>
</Project>
