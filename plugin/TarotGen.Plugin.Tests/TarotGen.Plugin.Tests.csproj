<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for everything in the plugin that does not touch the game: its Core folder,
    compiled in from the plugin rather than referenced, so this builds and runs with no
    Dalamud on the machine, which is what lets CI run it. `dotnet test` from plugin/
    runs it on Microsoft.Testing.Platform (plugin/global.json).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TarotGen.Plugin.Tests</RootNamespace>
    <!-- As the plugin: any warning fails the build; package advisories stay warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TarotGen.Plugin\Core\**\*.cs" LinkBase="Core" />
    <!-- The API's answers, written from backend/openapi.json's schemas with made-up names. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
