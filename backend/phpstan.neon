includes:
    # The shared PHPStan bar (shared-tooling's lint/php): level 8, full null-safety
    # on top of the level-6 array value-type rules. Every nullable access must be
    # guarded, and request/PDO/env values are narrowed to concrete types before use.
    - ../shared/lint/php/phpstan.neon
    # Pre-existing findings are baselined so `composer stan` stays green and only
    # *new* issues fail: today one interface-mandated `string|false` signature.
    # Burn it down over time; the bar for all new code is a clean run. Regenerate
    # with:
    #   composer stan -- --generate-baseline
    - phpstan-baseline.neon

parameters:
    paths:
        - includes/Tarot
        - api
        - bin
        - tests
        - db/migrations
        - phinx.php
    # phpstan-strict-rules, phpstan-deprecation-rules and phpstan-phpunit load
    # through phpstan/extension-installer (AUDIT §6.2).
    ignoreErrors:
        # PHPUnit's assertions are static methods that its own docs call as
        # $this->assertSame(); strict-rules' "static via instance" check stays on
        # for application code.
        -
            identifier: staticMethod.dynamicCall
            path: tests/*
