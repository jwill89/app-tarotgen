// markdownlint for the docs (`task shared:lint:md`, and CI): the shared config from
// `shared/lint/markdown`. The VS Code markdownlint extension reads this file too.
{
  "config": { "extends": "shared/lint/markdown/markdownlint.jsonc" },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/vendor/**",
    "shared/**",
    // Claude Code worktrees from earlier sessions: copies of the repo, not its docs.
    ".claude/**",
    "frontend/dist/**",
    "frontend/coverage/**",
    // A failed end-to-end run leaves Playwright's error-context.md files here.
    "frontend/test-results/**",
    "frontend/playwright-report/**",
    "plugin/**/bin/**",
    "plugin/**/obj/**"
  ]
}
