# TarotGen.io's scheduled jobs, installed on the host as /etc/cron.d/tarotgen (root:root 644,
# LF line endings) by every backend deploy, where it differs (SharedDeploy's Install-HostConfig).
# The deploy fills the words in double braces from its settings: the site's folder (WebRoot)
# and the private data folder (DataDir), and stops if one is left unfilled.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TAROT_DATA_DIR={{DATA_DIR}}

# The database's daily backup is not a cron job: tarotgen-backup.timer (SharedDeploy's
# Install-BackupTimer, installed by the deploy) writes it at 10:00 UTC, with up to 15
# minutes' spread, to {{DATA_DIR}}/db/backups/tarotgen-YYYY-MM-DD.db.gz (UTC date).
# Check it with: journalctl -u tarotgen-backup
#
# 10:30 UTC daily, once that window has passed: data retention. Guest
# readings older than a year are deleted, as the privacy policy states, and the planner
# statistics refreshed. It runs only when today's backup exists, so there is always a
# copy from before it; otherwise it logs that it skipped. The host's clock is UTC.
# Output: journalctl -t tarotgen-retention
30 10 * * * root backup={{DATA_DIR}}/db/backups/tarotgen-$(date -u +\%Y-\%m-\%d).db.gz; if [ -s "$backup" ]; then runuser -u www-data -- php {{WEB_ROOT}}/scripts/retention.php 2>&1 | logger -t tarotgen-retention; else logger -t tarotgen-retention "skipped: today's backup $backup is missing"; fi
