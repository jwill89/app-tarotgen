# Backend (PHP) — generated deps, server-side data, local config
/backend/vendor/
/backend/assets/
# Ignore the live DB and the retired one-off scripts, but keep the Phinx
# migrations and the schema generated from them.
/backend/db/*
!/backend/db/migrations/
!/backend/db/schema.sql
/backend/.phpunit.cache/
/backend/.php-cs-fixer.cache
/backend/.env

# Frontend (Vue) — generated deps + build output
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/test-results/
/frontend/playwright-report/
# The Playwright smoke run copies the built SPA here, where og.php reads it.
/backend/dist/

# Local deploy settings (server IP, SSH key path, web root) — never commit.
# Copy scripts/deploy.config.example.ps1 to create it.
/scripts/deploy.config.ps1

# Editor / agent — repo-level
/.idea/
/.vscode/
/.claude/
/AGENTS.md

# Catch any stray .env anywhere
.env

# Python bytecode (scripts/*.py)
__pycache__/
*.pyc

# OS / editor cruft (this tree lives under OneDrive on Windows)
.DS_Store
Thumbs.db
Desktop.ini
