{
  "name": "tarot-site",
  "private": true,
  "version": "5.5.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss,vue}\"",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen:types": "npx --yes openapi-typescript@^7 ../backend/openapi.json -o src/types/api.generated.ts",
    "gen:check": "npm run gen:types && git diff --exit-code src/types/api.generated.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.0.0",
    "@fortawesome/pro-regular-svg-icons": "^7.0.0",
    "@fortawesome/pro-solid-svg-icons": "^7.0.0",
    "@fortawesome/vue-fontawesome": "^3.3.0",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "bulma": "^1.0.4",
    "dompurify": "^3.4.11",
    "marked": "^18.1.3",
    "reka-ui": "^2.10.1",
    "turndown": "^7.2.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@jwill89/lint-web": "file:../shared/lint/web",
    "@jwill89/test-a11y": "file:../shared/test/a11y",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.44.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.1",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^13.0.0"
    }
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.6.0": true
  }
}
