# The Font Awesome Pro packages (@fortawesome, @awesome.me) come from Font Awesome's
# registry. The account's package token lives outside the repo: in ~/.npmrc locally,
# and in a CI secret, which the shared web and e2e workflows write to ~/.npmrc before
# npm ci.
@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/

# Local packages (the shared-tooling submodule's lint/web and test/a11y) install as
# copies, so their own dependencies come with them; a link would leave ESLint unable to
# find its plugins.
install-links=true
