{
  // The shared app settings (shared-tooling's lint/web): Vue's DOM base, unused locals and
  // parameters, switch fallthrough, and an index that may find nothing typed as such.
  "extends": "@jwill89/lint-web/tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
